---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Section from '../../components/Section.astro';
import RentalCard from '../../components/RentalCard.astro';
import { rentals } from '../../data/rentals';

const lang = 'en' as const;
const base = lang === 'es' ? '/es/' : '/';
const path = `${base}rentals/`;

const t = lang === 'es'
  ? {
      title: 'All Needs Discount LLC | Renta de Equipos en Ray City y el Sur de Georgia',
      description: 'Renta de bomba de concreto sobre trailer y contenedor roll-off para Ray City, Valdosta, Adel, Tifton, Waycross y comunidades cercanas del sur de Georgia. Equipos en óptimas condiciones. Solicita cotización en línea.',
      eyebrow: 'Renta de Equipos',
      heading: 'Renta la máquina, sin esperas.',
      subtitle: 'Dos unidades disponibles ahora, prácticamente nuevas y mantenidas en taller. Listas para proyectos en Ray City, Valdosta, Adel, Tifton, Waycross y comunidades cercanas del sur de Georgia. Solicita tarifas por día o por semana en línea.',
      ctaTitle: '¿Necesitas una de estas para tu proyecto?',
      ctaBody: 'Responde unas preguntas rápidas y te confirmamos disponibilidad y tarifa el mismo día. Si el trabajo lo hacemos nosotros, también te lo cotizamos completo.',
      quote: 'Solicitar cotización',
      breadcrumbHome: 'Inicio',
      breadcrumbHere: 'Renta de Equipos',
    }
  : {
      title: 'All Needs Discount LLC | Equipment Rental in Ray City & South Georgia',
      description: 'Trailer-mounted concrete pump and roll-off container rentals for Ray City, Valdosta, Adel, Tifton, Waycross, and nearby South Georgia communities. Late-model, shop-maintained equipment. Request a quote online.',
      eyebrow: 'Equipment Rental',
      heading: 'Rent the machine, skip the wait.',
      subtitle: 'Two units available now, both late-model and shop-maintained. Ready for projects in Ray City, Valdosta, Adel, Tifton, Waycross, and nearby South Georgia communities. Request daily and weekly rates online.',
      ctaTitle: 'Need one of these on your project?',
      ctaBody: 'Answer a few quick questions and we will confirm availability and rate the same day. If you would rather we do the work, we will quote the whole job too.',
      quote: 'Request a quote',
      breadcrumbHome: 'Home',
      breadcrumbHere: 'Equipment Rental',
    };

const listLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: t.breadcrumbHere,
  itemListElement: rentals.map((r, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: r[lang].name,
    url: new URL(`${base}rentals/${r.slug}/`, Astro.site).toString(),
  })),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.breadcrumbHome, item: new URL(base, Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: t.breadcrumbHere, item: new URL(path, Astro.site).toString() },
  ],
};
---
<Layout
  lang={lang}
  title={t.title}
  description={t.description}
  path={path}
  image={new URL('/og/rentals.jpg', Astro.site).toString()}
>
  <Header lang={lang} currentPath={path} altHref={lang === 'es' ? '/rentals/' : '/es/rentals/'} />

  <main id="main" class="text-white w-full">
    <nav class="w-full max-w-6xl mx-auto px-4 sm:px-6 md:px-8 pt-8" aria-label={lang === 'es' ? 'Ruta de navegación' : 'Breadcrumb'}>
      <ol class="flex items-center gap-2 font-mono text-[10px] uppercase tracking-widest text-white/40">
        <li><a href={base} class="hover:text-white transition-colors">{t.breadcrumbHome}</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-white/70" aria-current="page">{t.breadcrumbHere}</li>
      </ol>
    </nav>

    <Section id="rentals" eyebrow={t.eyebrow} title={t.heading} subtitle={t.subtitle}>
      <div class="grid gap-5 sm:grid-cols-2" role="list">
        {rentals.map((rental, i) => (
          <div role="listitem">
            <RentalCard rental={rental} lang={lang} index={`0${i + 1}`} />
          </div>
        ))}
      </div>

      <div class="mt-12 border-t border-white/15 pt-10">
        <h2 class="text-2xl sm:text-3xl font-bold text-white font-mono uppercase tracking-tight">
          {t.ctaTitle}
        </h2>
        <p class="mt-4 text-base text-white/70 max-w-2xl leading-relaxed">{t.ctaBody}</p>
        <div class="mt-8 flex flex-col sm:flex-row items-start sm:items-center gap-4">
          <a
            href={`${base}#contact`}
            class="font-mono text-sm uppercase tracking-widest border border-white px-6 py-3 hover:bg-white hover:text-[#14202a] transition-colors w-full sm:w-auto text-center"
          >
            {t.quote} →
          </a>
        </div>
      </div>

      <script type="application/ld+json" set:html={JSON.stringify(listLd)} />
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    </Section>
  </main>

  <Footer lang={lang} currentPath={path} />
</Layout>
