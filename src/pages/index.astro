---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import ServiceCard from '../components/ServiceCard.astro';
import RentalCard from '../components/RentalCard.astro';
import ContactAssistant from '../components/ContactAssistant.astro';
import { rentals } from '../data/rentals';

const services = [
  {
    title: 'Remodeling',
    description: 'Whole-home and single-room renovations throughout our South Georgia service area, from Ray City and Valdosta to Adel, Tifton, and Waycross. Kitchens, bathrooms, and living spaces built around how you actually live.',
  },
  {
    title: 'Additions',
    description: 'Expand your footprint with a new bedroom, garage, sunroom, or second story — designed to match the existing structure and current Georgia building code.',
  },
  {
    title: 'Roofing',
    description: 'Re-roofs, repairs, and storm damage restoration. Asphalt shingle and metal roofing installed to current Georgia code by a local contractor.',
  },
  {
    title: 'Painting',
    description: 'Interior and exterior house painting with proper prep, priming, and finishes that hold up to the South Georgia heat and humidity.',
  },
  {
    title: 'Flooring',
    description: 'Hardwood, laminate, LVP, and tile floor installation. Demolition, subfloor repair, and installation done right from the start.',
  },
  {
    title: 'Decks',
    description: 'New deck builds, replacements, and repairs. Pressure-treated, composite, and hardwood options with clean lines and solid footings.',
  },
];

const area = [
  'Ray City', 'Valdosta', 'Adel', 'Hahira', 'Lakeland', 'Nashville',
  'Tifton', 'Moultrie', 'Lenox', 'Milan', 'Waycross',
];

const faqs = [
  {
    question: 'Are you licensed and insured?',
    answer: 'Yes. All Needs Discount LLC is a licensed and insured residential remodeling and construction company based in Ray City, Georgia.',
  },
  {
    question: 'Do you offer free estimates?',
    answer: 'Yes. Send us a few details about your project and we will get back to you within one business day with a free, no-pressure written estimate.',
  },
  {
    question: 'What areas do you serve?',
    answer: 'Our service area includes Ray City, Valdosta, Adel, Hahira, Lakeland, Nashville, Tifton, Moultrie, Lenox, Milan, and Waycross, along with nearby South Georgia communities.',
  },
  {
    question: 'Who will work on my project?',
    answer: 'A small, owner-operated crew. The owner is on every job site, and every job is quoted, scheduled, and overseen directly — no subcontractors you did not approve.',
  },
  {
    question: 'Do you rent equipment?',
    answer: 'Yes. We rent a trailer-mounted Mayco concrete pump and a 14.2 yd³ roll-off container. We deliver the roll-off container to your site and haul it away when you are done.',
  },
  {
    question: 'What are your business hours?',
    answer: 'Monday through Saturday, 7:00 AM to 6:00 PM.',
  },
];

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: s.title,
    description: s.description,
  })),
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---
<Layout
  lang="en"
  title="All Needs Discount LLC | Remodeling & Construction in South Georgia"
  description="Licensed residential remodeling and construction based in Ray City, serving Valdosta, Adel, Tifton, Waycross, and nearby South Georgia communities. Remodeling, additions, roofing, painting, flooring, and decks. Request a free estimate online."
  path="/"
>
  <Header lang="en" currentPath="/" />

  <main id="main" class="text-white">
    <!-- HERO -->
    <section
      id="home"
      class="w-full max-w-6xl mx-auto px-4 sm:px-6 md:px-8 pt-16 sm:pt-24 pb-20 sm:pb-28 text-center scroll-mt-24"
      aria-labelledby="hero-title"
    >
      <p class="font-mono text-[10px] sm:text-xs uppercase tracking-[0.4em] text-white/50 mb-6">
        South Georgia · Licensed · Insured
      </p>
      <h1
        id="hero-title"
        class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight font-mono uppercase leading-[1.05]"
      >
        All Needs Discount<br />LLC
      </h1>
      <p class="mt-6 text-lg sm:text-2xl text-white/80 font-light max-w-2xl mx-auto leading-relaxed">
        Residential remodeling and construction, done with care. One call, one crew, one point of contact from quote to final walkthrough.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="#contact"
          class="font-mono text-sm uppercase tracking-widest border border-white px-6 py-3 hover:bg-white hover:text-[#081d33] transition-colors w-full sm:w-auto"
        >
          Get a free estimate
        </a>
        <a
          href="#contact"
          class="font-mono text-sm uppercase tracking-widest text-white/80 hover:text-white border-b border-white/40 hover:border-white pb-1 transition-colors"
        >
          Request a quote →
        </a>
      </div>
    </section>

    <!-- ABOUT -->
    <Section
      id="about"
      eyebrow="About"
      title="Built on referrals, not ads."
      subtitle="We are a small, owner-operated crew serving South Georgia. Every job is quoted, scheduled, and overseen directly — no subcontractors you didn't approve, no mystery line items on the invoice."
    >
      <div class="grid gap-6 sm:grid-cols-3 border-t border-white/15 pt-10" role="list">
        <div role="listitem">
          <p class="font-mono text-3xl sm:text-4xl text-white font-bold" aria-label="Over fifteen years of trade experience">15+</p>
          <p class="mt-2 text-sm text-white/60 font-mono uppercase tracking-widest">Years of trade experience</p>
        </div>
        <div role="listitem">
          <p class="font-mono text-3xl sm:text-4xl text-white font-bold" aria-label="The owner is present on every job site">100%</p>
          <p class="mt-2 text-sm text-white/60 font-mono uppercase tracking-widest">Owner on every job site</p>
        </div>
        <div role="listitem">
          <p class="font-mono text-3xl sm:text-4xl text-white font-bold">Written</p>
          <p class="mt-2 text-sm text-white/60 font-mono uppercase tracking-widest">Detailed quotes, no surprises</p>
        </div>
      </div>
    </Section>

    <!-- SERVICES -->
    <Section
      id="services"
      eyebrow="What we do"
      title="Services"
      subtitle="Six core trades under one roof. Bundled scopes, single point of accountability, less time chasing contractors."
    >
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" role="list">
        {services.map((service, i) => (
          <div role="listitem">
            <ServiceCard
              index={`0${i + 1}`}
              title={service.title}
              description={service.description}
            />
          </div>
        ))}
      </div>
      <script type="application/ld+json" set:html={JSON.stringify(serviceLd)} />
    </Section>

    <!-- EQUIPMENT RENTAL -->
    <Section
      id="rentals"
      eyebrow="Equipment Rental"
      title="Rent the machine, skip the wait."
      subtitle="Beyond the trades, we rent out our own equipment. Two units available now, both late-model and shop-maintained, ready to work throughout our South Georgia service area."
    >
      <div class="grid gap-5 sm:grid-cols-2" role="list">
        {rentals.map((rental, i) => (
          <div role="listitem">
            <RentalCard rental={rental} lang="en" index={`0${i + 1}`} />
          </div>
        ))}
      </div>
      <a
        href="/rentals/"
        class="mt-10 inline-block font-mono text-sm uppercase tracking-widest text-white/80 hover:text-white border-b border-white/40 hover:border-white pb-1 transition-colors"
      >
        See all rental equipment →
      </a>
    </Section>

    <!-- SERVICE AREA -->
    <Section
      id="area"
      eyebrow="Service Area"
      title="South Georgia and beyond."
      subtitle="Based in Ray City, GA, we serve homeowners across South Georgia, including Valdosta, Adel, Hahira, Lakeland, Nashville, Tifton, Moultrie, Lenox, Milan, and Waycross."
    >
      <ul class="flex flex-wrap gap-3" aria-label="Cities served in South Georgia">
        {area.map(city => (
          <li class="font-mono text-xs uppercase tracking-widest border border-white/20 px-4 py-2 text-white/80">
            {city}
          </li>
        ))}
      </ul>
    </Section>

    <!-- FAQ -->
    <Section
      id="faq"
      eyebrow="FAQ"
      title="Common questions."
      subtitle="The things homeowners ask us most, answered up front. If yours is not here, send it through the form below."
    >
      <div class="grid gap-x-10 gap-y-8 sm:grid-cols-2 border-t border-white/15 pt-10">
        {faqs.map(faq => (
          <div>
            <h3 class="text-base sm:text-lg font-bold text-white font-mono uppercase tracking-wide">
              {faq.question}
            </h3>
            <p class="mt-2 text-sm text-white/70 leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
      <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
    </Section>

    <!-- CONTACT -->
    <Section
      id="contact"
      eyebrow="Contact"
      title="Let's talk about your project."
      subtitle="Send a few details and we will get back to you within one business day with a free, no-pressure estimate."
    >
      <div class="grid gap-8 lg:grid-cols-2 border-t border-white/15 pt-10">
        <div class="space-y-5" itemprop="address" itemscope itemtype="https://schema.org/PostalAddress">
          <meta itemprop="streetAddress" content="169 GA-125" />
          <meta itemprop="addressLocality" content="Ray City" />
          <meta itemprop="addressRegion" content="GA" />
          <meta itemprop="postalCode" content="31645" />
          <meta itemprop="addressCountry" content="US" />
          <a
            href="mailto:allneedsdiscount1@gmail.com"
            class="block font-mono text-base sm:text-lg text-white hover:opacity-80 break-all transition-colors"
          >
            allneedsdiscount1@gmail.com
          </a>
          <p class="font-mono text-sm text-white/60">
            Mon – Sat · 7:00 AM – 6:00 PM<br />
            Ray City, GA · serving Valdosta and South Georgia
          </p>
          <p class="text-sm text-white/60 leading-relaxed max-w-sm">
            No phone tag. Answer a few quick questions and we will follow up with a free, no-pressure estimate.
          </p>
        </div>

        <ContactAssistant lang="en" />
      </div>
    </Section>
  </main>

  <Footer lang="en" currentPath="/" />
</Layout>
