---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Section from '../../components/Section.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import RentalCard from '../../components/RentalCard.astro';
import ContactAssistant from '../../components/ContactAssistant.astro';
import { rentals } from '../../data/rentals';

const services = [
  {
    title: 'Remodelación',
    description: 'Renovaciones de casa completa o por habitación en Valdosta, Ray City y todo el sur de Georgia. Cocinas, baños y áreas sociales diseñadas para cómo vives realmente.',
  },
  {
    title: 'Ampliaciones',
    description: 'Suma espacio con un cuarto nuevo, garaje, sunroom o segundo piso — integrado al diseño existente y bajo el código de construcción vigente de Georgia.',
  },
  {
    title: 'Techos',
    description: 'Re-techos, reparaciones y restauración por daños de tormenta. Teja asfáltica y metal instalados bajo el código actual de Georgia por un contratista local.',
  },
  {
    title: 'Pintura',
    description: 'Pintura interior y exterior con preparación, imprimación y acabados que resisten el calor y la humedad del sur de Georgia.',
  },
  {
    title: 'Pisos',
    description: 'Instalación de madera, laminado, LVP y baldosa. Demolición, reparación de subsuelo e instalación bien hecha desde el inicio.',
  },
  {
    title: 'Decks',
    description: 'Construcción nueva, reemplazo y reparaciones de decks. Madera tratada, composite y madera dura con líneas limpias y bases sólidas.',
  },
];

const area = [
  'Ray City', 'Valdosta', 'Hahira', 'Lake Park', 'Quitman', 'Adel',
  'Tifton', 'Moultrie', 'Thomasville', 'Tallahassee', 'Nashville',
];

const faqs = [
  {
    question: '¿Tienen licencia y seguro?',
    answer: 'Sí. All Needs Discount LLC es una empresa de remodelación y construcción residencial con licencia y seguro, con base en Ray City, Georgia.',
  },
  {
    question: '¿Dan estimados gratis?',
    answer: 'Sí. Cuéntanos los detalles de tu proyecto y te respondemos en menos de un día hábil con un estimado por escrito, gratis y sin compromiso.',
  },
  {
    question: '¿Qué zonas atienden?',
    answer: 'Estamos en Ray City, GA y atendemos Valdosta, Hahira, Lake Park, Quitman, Adel, Tifton, Moultrie, Thomasville, Nashville y toda la región del sur de Georgia.',
  },
  {
    question: '¿Quién trabaja en mi proyecto?',
    answer: 'Una cuadrilla pequeña operada por el dueño. El dueño está en cada obra, y cada trabajo se cotiza, agenda y supervisa directamente — sin subcontratistas que no hayas aprobado.',
  },
  {
    question: '¿Rentan equipos?',
    answer: 'Sí. Rentamos una bomba de concreto Mayco sobre trailer y un contenedor roll-off de 14.2 yd³. El contenedor lo entregamos en tu sitio y lo recogemos cuando terminas.',
  },
  {
    question: '¿Cuál es su horario?',
    answer: 'Lunes a sábado, de 7:00 AM a 6:00 PM.',
  },
];

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: s.title,
    description: s.description,
  })),
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---
<Layout
  lang="es"
  title="All Needs Discount LLC | Remodelación y Construcción en el Sur de Georgia"
  description="Remodelación y construcción residencial con licencia en Ray City, Valdosta y el sur de Georgia. Remodelación, ampliaciones, techos, pintura, pisos y decks. Solicita un estimado gratis en línea."
  path="/es/"
>
  <Header lang="es" currentPath="/es/" />

  <main id="main" class="text-white">
    <!-- HERO -->
    <section
      id="home"
      class="w-full max-w-6xl mx-auto px-4 sm:px-6 md:px-8 pt-16 sm:pt-24 pb-20 sm:pb-28 text-center scroll-mt-24"
      aria-labelledby="hero-title"
    >
      <p class="font-mono text-[10px] sm:text-xs uppercase tracking-[0.4em] text-white/50 mb-6">
        Sur de Georgia · Con licencia · Asegurado
      </p>
      <h1
        id="hero-title"
        class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight font-mono uppercase leading-[1.05]"
      >
        All Needs Discount<br />LLC
      </h1>
      <p class="mt-6 text-lg sm:text-2xl text-white/80 font-light max-w-2xl mx-auto leading-relaxed">
        Remodelación y construcción residencial, hecha con cuidado. Una llamada, una cuadrilla, un solo contacto desde la cotización hasta la entrega final.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="#contact"
          class="font-mono text-sm uppercase tracking-widest border border-white px-6 py-3 hover:bg-white hover:text-[#081d33] transition-colors w-full sm:w-auto"
        >
          Obtener estimado gratis
        </a>
        <a
          href="#contact"
          class="font-mono text-sm uppercase tracking-widest text-white/80 hover:text-white border-b border-white/40 hover:border-white pb-1 transition-colors"
        >
          Solicitar cotización →
        </a>
      </div>
    </section>

    <!-- ABOUT -->
    <Section
      id="about"
      eyebrow="Nosotros"
      title="Construido sobre referidos, no sobre anuncios."
      subtitle="Somos una cuadrilla pequeña, operada por el dueño, sirviendo al sur de Georgia. Cada trabajo se cotiza, agenda y supervisa directamente — sin subcontratistas no aprobados, sin líneas misteriosas en la factura."
    >
      <div class="grid gap-6 sm:grid-cols-3 border-t border-white/15 pt-10" role="list">
        <div role="listitem">
          <p class="font-mono text-3xl sm:text-4xl text-white font-bold" aria-label="Más de quince años de experiencia en el oficio">15+</p>
          <p class="mt-2 text-sm text-white/60 font-mono uppercase tracking-widest">Años de experiencia en el oficio</p>
        </div>
        <div role="listitem">
          <p class="font-mono text-3xl sm:text-4xl text-white font-bold" aria-label="El dueño está presente en cada obra">100%</p>
          <p class="mt-2 text-sm text-white/60 font-mono uppercase tracking-widest">El dueño en cada obra</p>
        </div>
        <div role="listitem">
          <p class="font-mono text-3xl sm:text-4xl text-white font-bold">Detallada</p>
          <p class="mt-2 text-sm text-white/60 font-mono uppercase tracking-widest">Cotización por escrito, sin sorpresas</p>
        </div>
      </div>
    </Section>

    <!-- SERVICES -->
    <Section
      id="services"
      eyebrow="Lo que hacemos"
      title="Servicios"
      subtitle="Seis oficios bajo un mismo techo. Alcances agrupados, un solo responsable, menos tiempo persiguiendo contratistas."
    >
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" role="list">
        {services.map((service, i) => (
          <div role="listitem">
            <ServiceCard
              index={`0${i + 1}`}
              title={service.title}
              description={service.description}
            />
          </div>
        ))}
      </div>
      <script type="application/ld+json" set:html={JSON.stringify(serviceLd)} />
    </Section>

    <!-- EQUIPMENT RENTAL -->
    <Section
      id="rentals"
      eyebrow="Renta de Equipos"
      title="Renta la máquina, sin esperas."
      subtitle="Además de los oficios, rentamos nuestro propio equipo. Dos unidades disponibles ahora, prácticamente nuevas y mantenidas en taller, listas para trabajar en el área de Valdosta."
    >
      <div class="grid gap-5 sm:grid-cols-2" role="list">
        {rentals.map((rental, i) => (
          <div role="listitem">
            <RentalCard rental={rental} lang="es" index={`0${i + 1}`} />
          </div>
        ))}
      </div>
      <a
        href="/es/rentals/"
        class="mt-10 inline-block font-mono text-sm uppercase tracking-widest text-white/80 hover:text-white border-b border-white/40 hover:border-white pb-1 transition-colors"
      >
        Ver todo el equipo en renta →
      </a>
    </Section>

    <!-- SERVICE AREA -->
    <Section
      id="area"
      eyebrow="Área de servicio"
      title="Sur de Georgia y más allá."
      subtitle="Con base en Ray City, GA, viajamos por el proyecto adecuado. Si no sabes si estás dentro del rango, solo pregunta."
    >
      <ul class="flex flex-wrap gap-3" aria-label="Ciudades atendidas en el sur de Georgia">
        {area.map(city => (
          <li class="font-mono text-xs uppercase tracking-widest border border-white/20 px-4 py-2 text-white/80">
            {city}
          </li>
        ))}
      </ul>
    </Section>

    <!-- FAQ -->
    <Section
      id="faq"
      eyebrow="Preguntas frecuentes"
      title="Preguntas comunes."
      subtitle="Lo que más nos preguntan los propietarios, respondido de frente. Si tu pregunta no está aquí, envíanla por el formulario."
    >
      <div class="grid gap-x-10 gap-y-8 sm:grid-cols-2 border-t border-white/15 pt-10">
        {faqs.map(faq => (
          <div>
            <h3 class="text-base sm:text-lg font-bold text-white font-mono uppercase tracking-wide">
              {faq.question}
            </h3>
            <p class="mt-2 text-sm text-white/70 leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
      <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
    </Section>

    <!-- CONTACT -->
    <Section
      id="contact"
      eyebrow="Contacto"
      title="Hablemos de tu proyecto."
      subtitle="Envíanos algunos detalles y te respondemos en menos de un día hábil con un estimado gratis y sin compromiso."
    >
      <div class="grid gap-8 lg:grid-cols-2 border-t border-white/15 pt-10">
        <div class="space-y-5" itemscope itemtype="https://schema.org/PostalAddress">
          <meta itemprop="streetAddress" content="169 GA-125" />
          <meta itemprop="addressLocality" content="Ray City" />
          <meta itemprop="addressRegion" content="GA" />
          <meta itemprop="postalCode" content="31645" />
          <meta itemprop="addressCountry" content="US" />
          <a
            href="mailto:allneedsdiscount1@gmail.com"
            class="block font-mono text-base sm:text-lg text-white hover:opacity-80 break-all transition-colors"
          >
            allneedsdiscount1@gmail.com
          </a>
          <p class="font-mono text-sm text-white/60">
            Lun – Sáb · 7:00 AM – 6:00 PM<br />
            Ray City, GA · sirviendo Valdosta y el sur de Georgia
          </p>
          <p class="text-sm text-white/60 leading-relaxed max-w-sm">
            Sin llamadas ni esperas. Responde unas preguntas rápidas y te contactamos con un estimado gratis y sin compromiso.
          </p>
        </div>

        <ContactAssistant lang="es" />
      </div>
    </Section>
  </main>

  <Footer lang="es" currentPath="/es/" />
</Layout>
