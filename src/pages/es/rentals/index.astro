---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Section from '../../../components/Section.astro';
import RentalCard from '../../../components/RentalCard.astro';
import { rentals } from '../../../data/rentals';

const lang = 'es' as const;
const base = lang === 'es' ? '/es/' : '/';
const path = `${base}rentals/`;

const t = lang === 'es'
  ? {
      title: 'All Needs Discount LLC | Renta de Equipos en Valdosta, GA',
      description: 'Renta de bomba de concreto sobre trailer y dump trailer de doble eje en Valdosta y el sur de Georgia. Equipos en óptimas condiciones. Llama al 678-622-1776 para tarifas.',
      eyebrow: 'Renta de Equipos',
      heading: 'Renta la máquina, sin esperas.',
      subtitle: 'Dos unidades disponibles ahora, prácticamente nuevas y mantenidas en taller. Entregadas listas para trabajar en el área de Valdosta. Llama para tarifas por día o por semana.',
      ctaTitle: '¿Necesitas una de estas para tu proyecto?',
      ctaBody: 'Llámanos y te decimos disponibilidad y tarifa el mismo día. Si el trabajo lo hacemos nosotros, también te lo cotizamos completo.',
      call: 'Llama 678 622 1776',
      quote: 'Solicitar cotización',
      breadcrumbHome: 'Inicio',
      breadcrumbHere: 'Renta de Equipos',
    }
  : {
      title: 'All Needs Discount LLC | Equipment Rental in Valdosta, GA',
      description: 'Trailer-mounted concrete pump and tandem-axle dump trailer for rent in Valdosta and South Georgia. Late-model, shop-maintained. Call 678-622-1776 for rates.',
      eyebrow: 'Equipment Rental',
      heading: 'Rent the machine, skip the wait.',
      subtitle: 'Two units available now, both late-model and shop-maintained. Delivered ready to work in the Valdosta area. Call for daily and weekly rates.',
      ctaTitle: 'Need one of these on your project?',
      ctaBody: 'Call and we will confirm availability and rate the same day. If you would rather we do the work, we will quote the whole job too.',
      call: 'Call 678 622 1776',
      quote: 'Request a quote',
      breadcrumbHome: 'Home',
      breadcrumbHere: 'Equipment Rental',
    };

const listLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: t.breadcrumbHere,
  itemListElement: rentals.map((r, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: r[lang].name,
    url: new URL(`${base}rentals/${r.slug}/`, Astro.site).toString(),
  })),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.breadcrumbHome, item: new URL(base, Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: t.breadcrumbHere, item: new URL(path, Astro.site).toString() },
  ],
};
---
<Layout
  lang={lang}
  title={t.title}
  description={t.description}
  path={path}
  image={new URL('/og/rentals.jpg', Astro.site).toString()}
>
  <Header lang={lang} currentPath={path} altHref={lang === 'es' ? '/rentals/' : '/es/rentals/'} />

  <main id="main" class="text-white w-full">
    <nav class="w-full max-w-6xl mx-auto px-4 sm:px-6 md:px-8 pt-8" aria-label={lang === 'es' ? 'Ruta de navegación' : 'Breadcrumb'}>
      <ol class="flex items-center gap-2 font-mono text-[10px] uppercase tracking-widest text-white/40">
        <li><a href={base} class="hover:text-white transition-colors">{t.breadcrumbHome}</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-white/70" aria-current="page">{t.breadcrumbHere}</li>
      </ol>
    </nav>

    <Section id="rentals" eyebrow={t.eyebrow} title={t.heading} subtitle={t.subtitle}>
      <div class="grid gap-5 sm:grid-cols-2" role="list">
        {rentals.map((rental, i) => (
          <div role="listitem">
            <RentalCard rental={rental} lang={lang} index={`0${i + 1}`} />
          </div>
        ))}
      </div>

      <div class="mt-12 border-t border-white/15 pt-10">
        <h2 class="text-2xl sm:text-3xl font-bold text-white font-mono uppercase tracking-tight">
          {t.ctaTitle}
        </h2>
        <p class="mt-4 text-base text-white/70 max-w-2xl leading-relaxed">{t.ctaBody}</p>
        <div class="mt-8 flex flex-col sm:flex-row items-start sm:items-center gap-4">
          <a
            href="tel:+16786221776"
            class="font-mono text-sm uppercase tracking-widest border border-white px-6 py-3 hover:bg-white hover:text-[#081d33] transition-colors w-full sm:w-auto text-center"
          >
            {t.call}
          </a>
          <a
            href={`${base}#contact`}
            class="font-mono text-sm uppercase tracking-widest text-white/80 hover:text-white border-b border-white/40 hover:border-white pb-1 transition-colors"
          >
            {t.quote} →
          </a>
        </div>
      </div>

      <script type="application/ld+json" set:html={JSON.stringify(listLd)} />
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    </Section>
  </main>

  <Footer lang={lang} currentPath={path} />
</Layout>
