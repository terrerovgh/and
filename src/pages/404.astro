---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  lang="en"
  title="Page Not Found | All Needs Discount LLC"
  description="The page you're looking for doesn't exist."
  path="/404/"
  noindex={true}
>
  <Header lang="en" currentPath="/404/" />

  <main id="main" class="w-full max-w-2xl mx-auto px-4 sm:px-6 md:px-8 py-24 sm:py-32 text-center flex flex-col items-center">
    <img src="/logo-mark.svg" alt="All Needs Discount LLC" class="h-16 w-16 sm:h-20 sm:w-20 mb-8 object-contain" width="80" height="80" />

    <p class="font-mono text-xs uppercase tracking-[0.3em] text-white/50 mb-3">Error 404</p>
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white font-mono uppercase mb-4">
      Page not found
    </h1>
    <p class="text-white/70 leading-relaxed mb-2">
      The page you're looking for doesn't exist or has moved.
    </p>
    <p class="text-white/70 leading-relaxed mb-10">
      La página que buscas no existe o fue movida.
    </p>

    <div class="flex flex-col sm:flex-row gap-3">
      <a
        href="/"
        class="inline-flex items-center justify-center text-white font-mono text-xs uppercase tracking-widest border border-white px-5 py-2.5 rounded hover:bg-white hover:text-[#14202a] transition-colors"
      >
        Back to Home
      </a>
      <a
        href="/es/"
        class="inline-flex items-center justify-center text-white/70 hover:text-white font-mono text-xs uppercase tracking-widest border border-white/20 hover:border-white/50 px-5 py-2.5 rounded transition-colors"
      >
        Ir al inicio (Español)
      </a>
    </div>
  </main>

  <Footer lang="en" currentPath="/404/" />
</Layout>
