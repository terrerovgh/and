---
import { Picture } from 'astro:assets';
import type { Rental } from '../data/rentals';

interface Props {
  rental: Rental;
  lang: 'en' | 'es';
  index: string;
}

const { rental, lang, index } = Astro.props;
const copy = rental[lang];
const href = `${lang === 'es' ? '/es' : ''}/rentals/${rental.slug}/`;
---

<a
  href={href}
  class="group flex flex-col overflow-hidden rounded-[3px] border border-white/[0.085] bg-[#1c2a36]/[0.72] shadow-[0_1px_0_rgba(255,255,255,0.045)_inset,0_18px_34px_-22px_rgba(4,10,15,0.9)] transition-[border-color,box-shadow,transform,background-color] duration-200 hover:-translate-y-0.5 hover:border-white/[0.16] hover:bg-[#22323f]/[0.85] hover:shadow-[0_1px_0_rgba(255,255,255,0.06)_inset,0_26px_44px_-24px_rgba(4,10,15,0.95)]"
>
  <Picture
    src={rental.hero}
    alt={copy.heroAlt}
    formats={['avif', 'webp']}
    widths={[400, 800, 1200]}
    quality={66}
    sizes="(min-width: 640px) 50vw, 100vw"
    loading="lazy"
    decoding="async"
    class="w-full aspect-[3/2] object-cover"
  />
  <div class="relative p-6 sm:p-8 flex flex-col flex-1">
    <span class="font-mono text-[10.5px] text-white/[0.26] group-hover:text-white/40 transition-colors absolute top-5 right-6 tracking-[0.24em]">
      {index}
    </span>
    <div class="w-10 h-0.5 bg-[#c69a63] mb-5 group-hover:w-16 transition-all duration-300"></div>
    <h3 class="text-xl font-semibold tracking-[-0.004em] text-[#f6f8f9]">
      {copy.name}
    </h3>
    <p class="mt-2 font-mono text-[10px] uppercase tracking-widest text-white/[0.38]">
      {copy.model}
    </p>
    <p class="mt-4 text-[14.5px] leading-[1.66] text-white/[0.64] text-pretty flex-1 transition-colors group-hover:text-white/[0.74]">
      {copy.teaser}
    </p>
    <span class="mt-6 font-mono text-xs uppercase tracking-widest text-[#c69a63] group-hover:text-[#d8ae78] transition-colors">
      {lang === 'es' ? 'Ver detalles' : 'View details'} →
    </span>
  </div>
</a>
