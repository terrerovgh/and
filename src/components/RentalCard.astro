---
import { Picture } from 'astro:assets';
import type { Rental } from '../data/rentals';

interface Props {
  rental: Rental;
  lang: 'en' | 'es';
  index: string;
}

const { rental, lang, index } = Astro.props;
const copy = rental[lang];
const href = `${lang === 'es' ? '/es' : ''}/rentals/${rental.slug}/`;
---

<a
  href={href}
  class="group flex flex-col border border-white/15 hover:border-white/40 bg-white/[0.02] transition-colors"
>
  <Picture
    src={rental.hero}
    alt={copy.heroAlt}
    formats={['avif', 'webp']}
    widths={[400, 800, 1200]}
    quality={66}
    sizes="(min-width: 640px) 50vw, 100vw"
    loading="lazy"
    decoding="async"
    class="w-full aspect-[3/2] object-cover"
  />
  <div class="relative p-6 sm:p-8 flex flex-col flex-1">
    <span class="font-mono text-xs text-white/40 absolute top-5 right-6 tracking-widest">
      {index}
    </span>
    <div class="w-10 h-px bg-white mb-5 group-hover:w-16 transition-all duration-300"></div>
    <h3 class="text-xl sm:text-2xl font-bold text-white font-mono uppercase tracking-wide">
      {copy.name}
    </h3>
    <p class="mt-2 font-mono text-[10px] uppercase tracking-widest text-white/40">
      {copy.model}
    </p>
    <p class="mt-4 text-sm sm:text-base text-white/70 leading-relaxed flex-1">
      {copy.teaser}
    </p>
    <span class="mt-6 font-mono text-xs uppercase tracking-widest text-white/80 group-hover:text-white transition-colors">
      {lang === 'es' ? 'Ver detalles' : 'View details'} →
    </span>
  </div>
</a>
