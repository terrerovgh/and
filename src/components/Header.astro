---
interface Props {
  lang: 'en' | 'es';
  currentPath: string;
  /* Where the EN/ES toggle points. Defaults to the other locale's home; detail
     pages pass their own twin so the toggle keeps you on the same equipment. */
  altHref?: string;
}

const { lang, currentPath, altHref } = Astro.props;

const base = lang === 'es' ? '/es/' : '/';
const isHome = currentPath === base;

/* Section links are same-page anchors on the home page, but must be absolute
   from anywhere else (/rentals/, /rentals/<slug>/) or they go nowhere. */
const anchor = (hash: string) => (isHome ? `#${hash}` : `${base}#${hash}`);

const nav = lang === 'es'
  ? [
      { href: anchor('home'), label: 'Inicio' },
      { href: anchor('about'), label: 'Nosotros' },
      { href: anchor('services'), label: 'Servicios' },
      { href: `${base}rentals/`, label: 'Renta' },
      { href: anchor('area'), label: 'Área' },
      { href: anchor('contact'), label: 'Contacto' },
    ]
  : [
      { href: anchor('home'), label: 'Home' },
      { href: anchor('about'), label: 'About' },
      { href: anchor('services'), label: 'Services' },
      { href: `${base}rentals/`, label: 'Rentals' },
      { href: anchor('area'), label: 'Service Area' },
      { href: anchor('contact'), label: 'Contact' },
    ];

const homeHref = lang === 'es' ? '/es/#home' : '/#home';
const otherHref = altHref ?? (lang === 'es' ? '/' : '/es/');
const otherLabel = lang === 'es' ? 'EN' : 'ES';
---

<header class="w-full border-b border-white/15 bg-[#081d33]/85 backdrop-blur-sm sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 md:px-8 py-4 flex items-center justify-between gap-4">
    <a href={homeHref} class="flex items-center gap-3 group" aria-label="All Needs Discount LLC home">
      <img
        src="/logo-mark.svg"
        alt="All Needs Discount LLC"
        class="h-9 w-9"
        width="36"
        height="36"
        loading="eager"
      />
      <span class="hidden sm:inline text-white font-mono font-bold tracking-wider text-sm uppercase group-hover:opacity-80">
        All Needs Discount
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-5 lg:gap-7 font-mono text-xs uppercase tracking-widest text-white/70" aria-label={lang === 'es' ? 'Navegación principal' : 'Main navigation'}>
      {nav.map(item => (
        <a href={item.href} class="hover:text-white transition-colors">{item.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={otherHref}
        class="text-white/60 hover:text-white font-mono text-xs uppercase tracking-widest border border-white/20 hover:border-white/50 px-2.5 py-1 rounded transition-colors"
        aria-label={`Switch to ${otherLabel}`}
      >
        {otherLabel}
      </a>
      <a
        href={anchor('contact')}
        class="hidden sm:inline-flex items-center text-white font-mono text-xs uppercase tracking-widest border border-white px-3 py-1.5 rounded hover:bg-white hover:text-[#081d33] transition-colors"
      >
        {lang === 'es' ? 'Cotizar' : 'Get a Quote'}
      </a>
    </div>
  </div>

  <nav class="md:hidden flex items-center justify-center gap-4 pb-3 font-mono text-[10px] uppercase tracking-widest text-white/70 overflow-x-auto" aria-label={lang === 'es' ? 'Navegación móvil' : 'Mobile navigation'}>
    {nav.map(item => (
      <a href={item.href} class="hover:text-white transition-colors whitespace-nowrap">{item.label}</a>
    ))}
  </nav>
</header>
