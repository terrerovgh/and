---
interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;

const projectTypes = lang === 'es'
  ? [
      { key: 'remodel', label: 'Remodelación' },
      { key: 'addition', label: 'Ampliación' },
      { key: 'roofing', label: 'Techo' },
      { key: 'painting', label: 'Pintura' },
      { key: 'flooring', label: 'Pisos' },
      { key: 'deck', label: 'Deck' },
      { key: 'rental', label: 'Renta de equipo' },
      { key: 'other', label: 'Otro' },
    ]
  : [
      { key: 'remodel', label: 'Remodeling' },
      { key: 'addition', label: 'Addition' },
      { key: 'roofing', label: 'Roofing' },
      { key: 'painting', label: 'Painting' },
      { key: 'flooring', label: 'Flooring' },
      { key: 'deck', label: 'Deck' },
      { key: 'rental', label: 'Equipment rental' },
      { key: 'other', label: 'Something else' },
    ];

const budgets = lang === 'es'
  ? ['Menos de $5,000', '$5,000 – $15,000', '$15,000 – $50,000', 'Más de $50,000', 'No estoy seguro']
  : ['Under $5,000', '$5,000 – $15,000', '$15,000 – $50,000', 'Over $50,000', 'Not sure yet'];

const t = lang === 'es'
  ? {
      stepLabels: ['Paso 1 de 4', 'Paso 2 de 4', 'Paso 3 de 4', 'Paso 4 de 4'],
      step1Title: '¿Qué necesitas?',
      step2Title: 'Presupuesto aproximado',
      step3Title: 'Cuéntanos más',
      step3Placeholder: 'Describe el proyecto: qué necesitas, tamaño aproximado y cuándo te gustaría empezar.',
      step4Title: '¿Cómo te contactamos?',
      name: 'Nombre',
      email: 'Correo',
      phone: 'Teléfono (opcional)',
      back: '← Atrás',
      next: 'Siguiente →',
      submit: 'Enviar solicitud',
      submitting: 'Enviando…',
      successTitle: 'Listo, recibimos tu solicitud.',
      successBody: 'Le llegó a nuestro equipo. Te contactamos por correo (o por teléfono si lo dejaste) dentro de un día hábil.',
      errorTitle: 'Algo falló al enviar.',
      errorBody: 'Intenta de nuevo. Si sigue sin funcionar, escríbenos directo:',
      mailtoFallback: 'Enviar por correo',
      needSelection: 'Elige una opción para continuar.',
      needContact: 'Escribe tu nombre y correo para continuar.',
      noscript: 'El asistente necesita JavaScript. Mientras tanto, escríbenos directo:',
    }
  : {
      stepLabels: ['Step 1 of 4', 'Step 2 of 4', 'Step 3 of 4', 'Step 4 of 4'],
      step1Title: 'What do you need?',
      step2Title: 'Rough budget',
      step3Title: 'Tell us more',
      step3Placeholder: 'Describe the project: what you need, rough size, and when you would like to start.',
      step4Title: 'How should we reach you?',
      name: 'Name',
      email: 'Email',
      phone: 'Phone (optional)',
      back: '← Back',
      next: 'Next →',
      submit: 'Send request',
      submitting: 'Sending…',
      successTitle: 'Got it — we received your request.',
      successBody: 'It just landed with our team. We will follow up by email (or phone, if you left one) within one business day.',
      errorTitle: 'Something went wrong sending that.',
      errorBody: 'Try again. If it keeps failing, email us directly:',
      mailtoFallback: 'Send by email',
      needSelection: 'Pick an option to continue.',
      needContact: 'Enter your name and email to continue.',
      noscript: 'The assistant needs JavaScript. In the meantime, email us directly:',
    };

const BUSINESS_EMAIL = 'allneedsdiscount1@gmail.com';
---

<div
  id="contact-assistant"
  class="border border-white/15 bg-white/[0.02] p-6 sm:p-8"
  data-lang={lang}
  data-step-labels={JSON.stringify(t.stepLabels)}
  data-submit-label={t.submit}
  data-submitting-label={t.submitting}
  data-success-title={t.successTitle}
  data-success-body={t.successBody}
  data-error-title={t.errorTitle}
  data-error-body={t.errorBody}
  data-mailto-fallback={t.mailtoFallback}
  data-need-selection={t.needSelection}
  data-need-contact={t.needContact}
  data-business-email={BUSINESS_EMAIL}
>
  <form id="lead-form" novalidate aria-label={t.step1Title}>
    <div class="hidden">
      <label>
        Company
        <input type="text" name="company" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <p id="lead-step-label" class="font-mono text-[10px] uppercase tracking-widest text-white/50 mb-4">
      {t.stepLabels[0]}
    </p>

    <fieldset data-step="1" class="lead-step">
      <legend class="text-lg sm:text-xl font-bold font-mono uppercase text-white mb-4">{t.step1Title}</legend>
      <div class="flex flex-wrap gap-2" role="radiogroup" aria-label={t.step1Title}>
        {projectTypes.map((p, i) => (
          <label class="cursor-pointer">
            <input type="radio" name="projectType" value={p.label} data-key={p.key} required={i === 0} class="peer sr-only" />
            <span class="block font-mono text-xs uppercase tracking-widest border border-white/30 px-4 py-2 text-white/70 peer-checked:border-white peer-checked:text-white peer-checked:bg-white/10 hover:border-white/60 transition-colors">
              {p.label}
            </span>
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset data-step="2" class="lead-step hidden">
      <legend class="text-lg sm:text-xl font-bold font-mono uppercase text-white mb-4">{t.step2Title}</legend>
      <div class="flex flex-wrap gap-2" role="radiogroup" aria-label={t.step2Title}>
        {budgets.map(b => (
          <label class="cursor-pointer">
            <input type="radio" name="budget" value={b} class="peer sr-only" />
            <span class="block font-mono text-xs uppercase tracking-widest border border-white/30 px-4 py-2 text-white/70 peer-checked:border-white peer-checked:text-white peer-checked:bg-white/10 hover:border-white/60 transition-colors">
              {b}
            </span>
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset data-step="3" class="lead-step hidden">
      <legend class="text-lg sm:text-xl font-bold font-mono uppercase text-white mb-4">{t.step3Title}</legend>
      <label class="block">
        <textarea
          name="details"
          id="lead-details"
          rows="5"
          placeholder={t.step3Placeholder}
          class="w-full bg-transparent border border-white/30 focus:border-white px-3 py-2 text-white font-sans outline-none transition-colors resize-y"
        ></textarea>
      </label>
    </fieldset>

    <fieldset data-step="4" class="lead-step hidden">
      <legend class="text-lg sm:text-xl font-bold font-mono uppercase text-white mb-4">{t.step4Title}</legend>
      <div class="space-y-4">
        <label class="block">
          <span class="font-mono text-[10px] uppercase tracking-widest text-white/60">{t.name}</span>
          <input
            type="text"
            name="name"
            required
            autocomplete="name"
            class="mt-1 w-full bg-transparent border border-white/30 focus:border-white px-3 py-2 text-white font-sans outline-none transition-colors"
          />
        </label>
        <label class="block">
          <span class="font-mono text-[10px] uppercase tracking-widest text-white/60">{t.email}</span>
          <input
            type="email"
            name="email"
            required
            autocomplete="email"
            class="mt-1 w-full bg-transparent border border-white/30 focus:border-white px-3 py-2 text-white font-sans outline-none transition-colors"
          />
        </label>
        <label class="block">
          <span class="font-mono text-[10px] uppercase tracking-widest text-white/60">{t.phone}</span>
          <input
            type="tel"
            name="phone"
            autocomplete="tel"
            inputmode="tel"
            class="mt-1 w-full bg-transparent border border-white/30 focus:border-white px-3 py-2 text-white font-sans outline-none transition-colors"
          />
        </label>
      </div>
    </fieldset>

    <p id="lead-inline-error" class="hidden mt-4 text-sm text-amber-300 font-mono" role="alert"></p>

    <div class="mt-8 flex items-center justify-between gap-4">
      <button
        type="button"
        id="lead-back"
        class="hidden font-mono text-sm uppercase tracking-widest text-white/70 hover:text-white transition-colors"
      >
        {t.back}
      </button>
      <div class="ml-auto flex gap-4">
        <button
          type="button"
          id="lead-next"
          class="font-mono text-sm uppercase tracking-widest border border-white px-6 py-3 text-white hover:bg-white hover:text-[#14202a] transition-colors"
        >
          {t.next}
        </button>
        <button
          type="submit"
          id="lead-submit"
          class="hidden font-mono text-sm uppercase tracking-widest border border-white px-6 py-3 text-white hover:bg-white hover:text-[#14202a] transition-colors disabled:opacity-50"
        >
          {t.submit}
        </button>
      </div>
    </div>
  </form>

  <div id="lead-result" class="hidden" role="status" aria-live="polite"></div>

  <noscript>
    <p class="mt-4 font-mono text-sm text-white/70">
      {t.noscript}
      {' '}
      <a href={`mailto:${BUSINESS_EMAIL}`} class="text-white underline">{BUSINESS_EMAIL}</a>
    </p>
  </noscript>
</div>

<script>
  function initContactAssistant(root: HTMLElement) {
    const form = root.querySelector<HTMLFormElement>('#lead-form')!;
    const steps = Array.from(root.querySelectorAll<HTMLFieldSetElement>('.lead-step'));
    const stepLabelEl = root.querySelector<HTMLElement>('#lead-step-label')!;
    const backBtn = root.querySelector<HTMLButtonElement>('#lead-back')!;
    const nextBtn = root.querySelector<HTMLButtonElement>('#lead-next')!;
    const submitBtn = root.querySelector<HTMLButtonElement>('#lead-submit')!;
    const inlineError = root.querySelector<HTMLElement>('#lead-inline-error')!;
    const resultEl = root.querySelector<HTMLElement>('#lead-result')!;

    const stepLabels: string[] = JSON.parse(root.dataset.stepLabels || '[]');
    const lang = root.dataset.lang === 'es' ? 'es' : 'en';
    const businessEmail = root.dataset.businessEmail || '';

    let current = 1;

    function showStep(n: number) {
      steps.forEach(s => s.classList.toggle('hidden', Number(s.dataset.step) !== n));
      stepLabelEl.textContent = stepLabels[n - 1] || '';
      backBtn.classList.toggle('hidden', n === 1);
      nextBtn.classList.toggle('hidden', n === steps.length);
      submitBtn.classList.toggle('hidden', n !== steps.length);
      inlineError.classList.add('hidden');
    }

    function currentStepValid(n: number): boolean {
      const step = steps.find(s => Number(s.dataset.step) === n);
      if (!step) return true;
      if (n === 1 || n === 2) {
        const name = n === 1 ? 'projectType' : 'budget';
        const checked = step.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`);
        if (n === 1 && !checked) {
          inlineError.textContent = root.dataset.needSelection || '';
          inlineError.classList.remove('hidden');
          return false;
        }
        return true;
      }
      if (n === 4) {
        const nameInput = step.querySelector<HTMLInputElement>('input[name="name"]')!;
        const emailInput = step.querySelector<HTMLInputElement>('input[name="email"]')!;
        if (!nameInput.checkValidity() || !emailInput.checkValidity()) {
          inlineError.textContent = root.dataset.needContact || '';
          inlineError.classList.remove('hidden');
          return false;
        }
      }
      return true;
    }

    nextBtn.addEventListener('click', () => {
      if (!currentStepValid(current)) return;
      current = Math.min(current + 1, steps.length);
      showStep(current);
    });

    backBtn.addEventListener('click', () => {
      current = Math.max(current - 1, 1);
      showStep(current);
    });

    // Deep link from a rental page: ?equipment=<name> preselects "rental" and
    // prefills the free-text step so the wizard opens already on-topic.
    const params = new URLSearchParams(location.search);
    const equipment = params.get('equipment');
    if (equipment) {
      const rentalRadio = form.querySelector<HTMLInputElement>('input[name="projectType"][data-key="rental"]');
      if (rentalRadio) rentalRadio.checked = true;
      const details = form.querySelector<HTMLTextAreaElement>('#lead-details');
      if (details) {
        details.value = lang === 'es'
          ? `Interesado en rentar: ${equipment}`
          : `Interested in renting: ${equipment}`;
      }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentStepValid(current)) return;

      submitBtn.disabled = true;
      submitBtn.textContent = root.dataset.submittingLabel || '';

      const data = new FormData(form);
      const payload = {
        projectType: data.get('projectType') || '',
        budget: data.get('budget') || '',
        details: data.get('details') || '',
        name: data.get('name') || '',
        email: data.get('email') || '',
        phone: data.get('phone') || '',
        company: data.get('company') || '',
        lang,
      };

      try {
        const res = await fetch('/api/lead', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error('request_failed');
        const json = await res.json();

        form.classList.add('hidden');
        resultEl.classList.remove('hidden');
        resultEl.innerHTML = `
          <p class="text-lg sm:text-xl font-bold font-mono uppercase text-white">${root.dataset.successTitle}</p>
          <p class="mt-3 text-sm text-white/70 leading-relaxed">${root.dataset.successBody}</p>
          ${json?.summary ? `<p class="mt-4 text-sm text-white/60 border-l border-white/20 pl-4">${escapeHtml(json.summary)}</p>` : ''}
        `;
      } catch {
        resultEl.classList.remove('hidden');
        resultEl.innerHTML = `
          <p class="text-lg sm:text-xl font-bold font-mono uppercase text-white">${root.dataset.errorTitle}</p>
          <p class="mt-3 text-sm text-white/70 leading-relaxed">
            ${root.dataset.errorBody}
            <a href="mailto:${businessEmail}" class="text-white underline">${businessEmail}</a>
          </p>
        `;
        submitBtn.disabled = false;
        submitBtn.textContent = root.dataset.submitLabel || '';
      }
    });

    function escapeHtml(s: string): string {
      const div = document.createElement('div');
      div.textContent = s;
      return div.innerHTML;
    }

    showStep(1);
  }

  document.querySelectorAll<HTMLElement>('#contact-assistant').forEach(initContactAssistant);
</script>
