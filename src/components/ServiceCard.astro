---
interface Props {
  index: string;
  title: string;
  description: string;
}

const { index, title, description } = Astro.props;
---

<article class="group relative border border-white/15 hover:border-white/40 transition-colors p-6 sm:p-8 bg-white/[0.02]">
  <span class="font-mono text-xs text-white/40 absolute top-4 right-4 tracking-widest">
    {index}
  </span>
  <div class="w-10 h-px bg-white mb-5 group-hover:w-16 transition-all duration-300"></div>
  <h3 class="text-xl sm:text-2xl font-bold text-white font-mono uppercase tracking-wide mb-3">
    {title}
  </h3>
  <p class="text-sm sm:text-base text-white/70 leading-relaxed">
    {description}
  </p>
</article>
