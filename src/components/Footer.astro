---
interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="w-full border-t border-white/15 mt-24">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 md:px-8 py-10 grid gap-8 md:grid-cols-4 text-white/80">
    <div class="md:col-span-2">
      <div class="flex items-center gap-3 mb-4">
        <img src="/logo-white.svg" alt="All Needs Discount LLC" class="h-8 w-auto" width="120" height="32" loading="lazy" />
        <span class="font-mono font-bold tracking-wider text-sm uppercase text-white">All Needs Discount</span>
      </div>
      <p class="text-sm text-white/60 leading-relaxed">
        {lang === 'es'
          ? 'Remodelación y construcción residencial en el sur de Georgia. Calidad, oficio y comunicación directa.'
          : 'Residential remodeling and construction in South Georgia. Quality craftsmanship and direct communication.'}
      </p>
    </div>

    <div>
      <h3 class="font-mono text-xs uppercase tracking-widest text-white mb-4">
        {lang === 'es' ? 'Contacto' : 'Contact'}
      </h3>
      <ul class="space-y-2 text-sm font-mono">
        <li>
          <a href="tel:6786221776" class="hover:text-white transition-colors">678 622 1776</a>
        </li>
        <li>
          <a href="mailto:allneedsdiscount1@gmail.com" class="hover:text-white transition-colors break-all">
            allneedsdiscount1@gmail.com
          </a>
        </li>
        <li class="text-white/60">
          {lang === 'es' ? 'Valdosta · Sur de Georgia' : 'Valdosta · South Georgia'}
        </li>
      </ul>
    </div>

    <div>
      <h3 class="font-mono text-xs uppercase tracking-widest text-white mb-4">
        {lang === 'es' ? 'Navegación' : 'Navigation'}
      </h3>
      <ul class="space-y-2 text-sm font-mono">
        <li><a href="#about" class="hover:text-white transition-colors">{lang === 'es' ? 'Nosotros' : 'About'}</a></li>
        <li><a href="#services" class="hover:text-white transition-colors">{lang === 'es' ? 'Servicios' : 'Services'}</a></li>
        <li><a href="#area" class="hover:text-white transition-colors">{lang === 'es' ? 'Área de servicio' : 'Service Area'}</a></li>
        <li><a href="#contact" class="hover:text-white transition-colors">{lang === 'es' ? 'Solicitar cotización' : 'Request a quote'}</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 md:px-8 py-5 flex flex-col sm:flex-row items-center justify-between gap-2 text-[10px] font-mono uppercase tracking-widest text-white/50">
      <span>© {year} All Needs Discount LLC</span>
      <span>{lang === 'es' ? 'Licencia · Seguros al día' : 'Licensed · Insured'}</span>
    </div>
  </div>
</footer>
