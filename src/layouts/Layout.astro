---
import '../styles/global.css';
import BlueprintBackdrop from '../components/BlueprintBackdrop.astro';

interface Props {
  lang?: 'en' | 'es';
  title?: string;
  description?: string;
  path?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const SITE_URL = 'https://allneedsdiscount.com';
const OG_IMAGE = `${SITE_URL}/og/og-image.jpg`;
const BUSINESS_NAME = 'All Needs Discount LLC';
const PHONE = '+1-678-622-1776';
const EMAIL = 'allneedsdiscount1@gmail.com';
const ADDRESS = {
  street: '169 GA-125',
  city: 'Ray City',
  region: 'GA',
  postalCode: '31645',
  country: 'US',
};
const GEO = { lat: 31.03753840584961, lng: -83.19888045988867 };
const MAPS_URL = `https://www.google.com/maps/search/?api=1&query=${GEO.lat},${GEO.lng}`;
const descEn = 'Licensed residential remodeling and construction in South Georgia. Remodeling, additions, roofing, painting, flooring, and decks. Based in Ray City, GA, serving Valdosta, Adel, Tifton, Waycross, and nearby South Georgia communities. Request a free estimate online.';
const descEs = 'Remodelación y construcción residencial con licencia en el sur de Georgia. Remodelación, ampliaciones, techos, pintura, pisos y decks. Con base en Ray City, GA, atendemos Valdosta, Adel, Tifton, Waycross y comunidades cercanas del sur de Georgia. Solicita un estimado gratis en línea.';

const {
  lang = 'en',
  title = `${BUSINESS_NAME} | Remodeling & Construction in South Georgia`,
  description = lang === 'es' ? descEs : descEn,
  path = '/',
  image = OG_IMAGE,
  type = 'website',
  noindex = false,
} = Astro.props;

const canonical = new URL(path, SITE_URL).toString();

/* `path` is the CURRENT page's path and already carries the /es prefix on
   Spanish pages. Strip it before deriving the alternates, or the Spanish side
   emits /es/es/... and points hreflang="en" at the Spanish URL. */
const bare = path.replace(/^\/es(?=\/|$)/, '') || '/';
const enUrl = new URL(bare, SITE_URL).toString();
const esUrl = new URL(`/es${bare}`, SITE_URL).toString();

const titleEn = `${BUSINESS_NAME} | Remodeling & Construction in South Georgia`;
const titleEs = `${BUSINESS_NAME} | Remodelación y Construcción en el Sur de Georgia`;
const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  '@id': `${SITE_URL}/#organization`,
  name: BUSINESS_NAME,
  alternateName: 'AND',
  url: SITE_URL,
  logo: `${SITE_URL}/android-chrome-512x512.png`,
  image: [OG_IMAGE, `${SITE_URL}/og/rentals.jpg`],
  description: lang === 'es' ? descEs : descEn,
  telephone: PHONE,
  email: EMAIL,
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: ADDRESS.street,
    addressLocality: ADDRESS.city,
    addressRegion: ADDRESS.region,
    postalCode: ADDRESS.postalCode,
    addressCountry: ADDRESS.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: GEO.lat,
    longitude: GEO.lng,
  },
  hasMap: MAPS_URL,
  areaServed: [
    { '@type': 'City', name: 'Ray City' },
    { '@type': 'City', name: 'Valdosta' },
    { '@type': 'City', name: 'Adel' },
    { '@type': 'City', name: 'Hahira' },
    { '@type': 'City', name: 'Lakeland' },
    { '@type': 'City', name: 'Nashville' },
    { '@type': 'City', name: 'Tifton' },
    { '@type': 'City', name: 'Moultrie' },
    { '@type': 'City', name: 'Lenox' },
    { '@type': 'City', name: 'Milan' },
    { '@type': 'City', name: 'Waycross' },
  ],
  makesOffer: [
    {
      '@type': 'Offer',
      businessFunction: 'http://purl.org/goodrelations/v1#LeaseOut',
      availability: 'https://schema.org/InStock',
      url: `${SITE_URL}/rentals/concrete-pump/`,
      itemOffered: {
        '@type': 'Product',
        name: lang === 'es' ? 'Bomba de Concreto sobre Trailer' : 'Trailer-Mounted Concrete Pump',
        brand: { '@type': 'Brand', name: 'Mayco' },
        image: `${SITE_URL}/og/rental-concrete-pump.jpg`,
      },
    },
    {
      '@type': 'Offer',
      businessFunction: 'http://purl.org/goodrelations/v1#LeaseOut',
      availability: 'https://schema.org/InStock',
      url: `${SITE_URL}/rentals/roll-off-container/`,
      itemOffered: {
        '@type': 'Product',
        name: lang === 'es' ? 'Contenedor Roll-Off' : 'Roll-Off Container',
        brand: { '@type': 'Brand', name: 'Panther Cargo' },
        image: `${SITE_URL}/og/rental-roll-off-container.jpg`,
      },
    },
  ],
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
    opens: '07:00',
    closes: '18:00',
  }],
  /* TODO: enlazar perfiles reales cuando existan (Google Business Profile,
     Facebook) — Google los usa para conectar la entidad local con el GBP. */
  sameAs: [],
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  url: SITE_URL,
  name: BUSINESS_NAME,
  inLanguage: ['en-US', 'es-US'],
};
---
<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#111d27" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta name="format-detection" content="telephone=yes" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={BUSINESS_NAME} />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/logo-mark.svg" color="#14202a" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={BUSINESS_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:secure_url" content={image} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={BUSINESS_NAME} />
    <meta property="og:locale" content={lang === 'es' ? 'es_US' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_US'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={BUSINESS_NAME} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(organizationLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
  </head>
  <body class="blueprint-grid-bg text-white font-sans antialiased min-h-screen flex flex-col justify-center items-center selection:bg-cyan-400 selection:text-slate-950">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-white focus:text-[#14202a] focus:px-4 focus:py-2 focus:font-mono focus:text-sm focus:uppercase focus:tracking-widest">
      {lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}
    </a>
    <BlueprintBackdrop />
    <slot />
  </body>
</html>
