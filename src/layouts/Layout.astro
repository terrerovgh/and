---
import '../styles/global.css';
import BlueprintBackdrop from '../components/BlueprintBackdrop.astro';

interface Props {
  lang?: 'en' | 'es';
  title?: string;
  description?: string;
  path?: string;
  image?: string;
  type?: 'website' | 'article';
}

const SITE_URL = 'https://allneedsdiscount.com';
const OG_IMAGE = `${SITE_URL}/og-image.svg`;
const BUSINESS_NAME = 'All Needs Discount LLC';
const PHONE = '+1-678-622-1776';
const EMAIL = 'allneedsdiscount1@gmail.com';

const {
  lang = 'en',
  title = `${BUSINESS_NAME} | Remodeling & Construction in South Georgia`,
  description = 'Licensed residential remodeling and construction in South Georgia. Remodeling, additions, roofing, painting, flooring, and decks. Valdosta, GA. Call 678-622-1776 for a free estimate.',
  path = '/',
  image = OG_IMAGE,
  type = 'website',
} = Astro.props;

const canonical = new URL(path, SITE_URL).toString();
const enUrl = new URL(path === '/' ? '/' : `/${path.replace(/^\/+/, '')}`, SITE_URL).toString();
const esUrl = new URL(`/es${path === '/' ? '/' : `/${path.replace(/^\/+/, '')}`}`, SITE_URL).toString();

const titleEn = `${BUSINESS_NAME} | Remodeling & Construction in South Georgia`;
const titleEs = `${BUSINESS_NAME} | Remodelación y Construcción en el Sur de Georgia`;
const descEn = 'Licensed residential remodeling and construction in South Georgia. Remodeling, additions, roofing, painting, flooring, and decks. Valdosta, GA. Call 678-622-1776 for a free estimate.';
const descEs = 'Remodelación y construcción residencial con licencia en el sur de Georgia. Remodelación, ampliaciones, techos, pintura, pisos y decks. Valdosta, GA. Llama al 678-622-1776 para un estimado gratis.';

const keywords = lang === 'es'
  ? ['remodelación Georgia', 'contratista Valdosta', 'constructora sur de Georgia', 'remodelación residencial', 'reparación de techos', 'pintura residencial', 'instalación de pisos', 'construcción de decks', 'ampliaciones de casa']
  : ['remodeling South Georgia', 'Valdosta contractor', 'residential remodeling', 'home additions', 'roofing repair', 'house painting', 'flooring installation', 'deck building', 'licensed contractor Georgia'];

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  '@id': `${SITE_URL}/#organization`,
  name: BUSINESS_NAME,
  alternateName: 'AND',
  url: SITE_URL,
  logo: `${SITE_URL}/android-chrome-512x512.png`,
  image: OG_IMAGE,
  description: lang === 'es' ? descEs : descEn,
  telephone: PHONE,
  email: EMAIL,
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Valdosta',
    addressRegion: 'GA',
    addressCountry: 'US',
  },
  areaServed: [
    { '@type': 'City', name: 'Valdosta' },
    { '@type': 'City', name: 'Hahira' },
    { '@type': 'City', name: 'Lake Park' },
    { '@type': 'City', name: 'Quitman' },
    { '@type': 'City', name: 'Adel' },
    { '@type': 'City', name: 'Tifton' },
    { '@type': 'City', name: 'Moultrie' },
    { '@type': 'City', name: 'Thomasville' },
    { '@type': 'City', name: 'Tallahassee' },
    { '@type': 'City', name: 'Nashville' },
  ],
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
    opens: '07:00',
    closes: '18:00',
  }],
  sameAs: [],
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  url: SITE_URL,
  name: BUSINESS_NAME,
  inLanguage: ['en-US', 'es-US'],
};
---
<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#081d33" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="googlebot" content="index, follow" />
    <meta name="format-detection" content="telephone=yes" />
    <meta name="geo.region" content="US-GA" />
    <meta name="geo.placename" content="Valdosta, Georgia" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <meta name="author" content={BUSINESS_NAME} />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <link rel="icon" type="image/svg+xml" href="/logo-mark.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/logo-mark.svg" color="#081d33" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={BUSINESS_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={BUSINESS_NAME} />
    <meta property="og:locale" content={lang === 'es' ? 'es_US' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_US'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={BUSINESS_NAME} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(organizationLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
  </head>
  <body class="blueprint-grid-bg text-white font-sans antialiased min-h-screen flex flex-col justify-center items-center selection:bg-cyan-400 selection:text-slate-950">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-white focus:text-[#081d33] focus:px-4 focus:py-2 focus:font-mono focus:text-sm focus:uppercase focus:tracking-widest">
      {lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}
    </a>
    <BlueprintBackdrop />
    <slot />
  </body>
</html>
